rules_version = '2';

// Membership changes, quotas and external calls happen in Cloud Functions;
// clients only touch data of households they belong to.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && me() in householdData(hid).memberIds;
    }

    function isAdmin(hid) {
      return signedIn() && me() in householdData(hid).adminIds;
    }

    // Someone who was ever in the household keeps a member document (left,
    // removed or deleted their account). Their old expenses stay, and an edit
    // of one can change their balance, so the others must still be able to
    // settle with them. A uid without a member document is a stranger.
    function hasMemberDoc(hid, uid) {
      return exists(/databases/$(database)/documents/households/$(hid)/members/$(uid));
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    match /users/{userId} {
      allow read: if signedIn() && me() == userId;
      allow create: if signedIn() && me() == userId
        && request.resource.data.get('householdIds', []).size() == 0
        && !('proUntil' in request.resource.data);
      allow update: if signedIn() && me() == userId
        && unchanged(['householdIds', 'proUntil']);
      allow delete: if false;
    }

    match /households/{hid} {
      allow read: if signedIn() && me() in resource.data.memberIds;
      allow update: if signedIn() && me() in resource.data.adminIds
        && changesOnly(['name', 'currency'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.currency in ['TRY', 'EUR', 'USD', 'GBP'];
      allow create, delete: if false;

      match /members/{memberId} {
        allow read: if isMember(hid);
        allow update: if isMember(hid) && (
          (memberId == me() && changesOnly(['displayName', 'avatarEmoji', 'iban'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 40
            && request.resource.data.get('avatarEmoji', '') is string
            && request.resource.data.get('avatarEmoji', '').size() <= 16
            && (request.resource.data.get('iban', null) == null
              || (request.resource.data.iban is string
                && request.resource.data.iban.size() <= 34)))
          || (isAdmin(hid) && changesOnly(['rentWeight'])
            && request.resource.data.rentWeight is int
            && request.resource.data.rentWeight >= 0
            && request.resource.data.rentWeight <= 100)
        );
        allow create, delete: if false;
      }

      // The sum of shares cannot be checked in rules (no loops); the client
      // computes it with lib/core/money and the keys are validated here.
      function validExpenseFields(d) {
        return d.amountMinor is int && d.amountMinor > 0
          && d.shares is map && d.shares.size() > 0
          && d.status == 'final'
          && d.splitType in ['equal', 'exact', 'percent', 'shares']
          && d.description is string && d.description.size() > 0
          && d.description.size() <= 100
          && d.date is timestamp;
      }

      // A new expense only involves current members.
      function validExpense(d) {
        let members = householdData(hid).memberIds;
        return validExpenseFields(d)
          && d.paidBy in members
          && d.shares.keys().hasOnly(members);
      }

      // An edit may keep the payer and participants already on the stored
      // expense even after they left or deleted their account (otherwise old
      // expenses could never be fixed); anyone newly added must be a current
      // member.
      function validExpenseEdit(d, stored) {
        let members = householdData(hid).memberIds;
        let newKeys = d.shares.keys().toSet().difference(members.toSet());
        return validExpenseFields(d)
          && (d.paidBy in members || d.paidBy == stored.paidBy)
          && newKeys.difference(stored.shares.keys().toSet()).size() == 0;
      }

      match /expenses/{eid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdBy == me()
          && validExpense(request.resource.data);
        // A pending bill is also filled in by its payer (who gets the
        // reminder), but the payer cannot hand the bill to someone else.
        allow update: if isMember(hid)
          && (resource.data.createdBy == me() || isAdmin(hid)
            || (resource.data.status == 'pendingAmount'
              && resource.data.paidBy == me()
              && request.resource.data.paidBy == me()))
          && unchanged(['createdBy', 'createdAt'])
          && validExpenseEdit(request.resource.data, resource.data);
        allow delete: if isMember(hid)
          && (resource.data.createdBy == me() || isAdmin(hid));
      }

      match /settlements/{sid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdBy == me()
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor > 0
          && (request.resource.data.fromUid in householdData(hid).memberIds
            || hasMemberDoc(hid, request.resource.data.fromUid))
          && (request.resource.data.toUid in householdData(hid).memberIds
            || hasMemberDoc(hid, request.resource.data.toUid))
          && request.resource.data.fromUid != request.resource.data.toUid
          && (me() in [request.resource.data.fromUid, request.resource.data.toUid]
            || isAdmin(hid));
        allow update: if false;
        allow delete: if isMember(hid)
          && (me() in [resource.data.fromUid, resource.data.toUid] || isAdmin(hid));
      }

      match /recurring/{rid} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.amountMinor is int
          && request.resource.data.amountMinor >= 0
          && request.resource.data.paidBy in householdData(hid).memberIds
          && request.resource.data.frequency in ['monthly', 'weekly']
          && request.resource.data.nextRunAt is timestamp;
      }

      // The stored document is checked (also on "mark done" updates, which
      // only send done/doneBy/doneAt), so oversized or unknown fields never land.
      function validShoppingItem(d) {
        return d.keys().hasOnly(['name', 'quantity', 'addedBy', 'done', 'doneBy', 'doneAt', 'createdAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && (d.get('quantity', null) == null
            || (d.quantity is string && d.quantity.size() <= 40))
          && d.addedBy is string
          && d.get('done', false) is bool;
      }

      match /shoppingItems/{id} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.addedBy == me()
          && validShoppingItem(request.resource.data);
        allow update: if isMember(hid)
          && unchanged(['addedBy', 'createdAt'])
          && validShoppingItem(request.resource.data);
      }

      match /chores/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.frequency in ['daily', 'weekly', 'biweekly']
          && request.resource.data.rotation is list
          && request.resource.data.rotation.size() > 0
          && request.resource.data.rotation.hasOnly(householdData(hid).memberIds);
      }

      match /choreLogs/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.doneBy == me();
      }

      match /activity/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.actorUid == me();
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /usage/{uid} {
      allow read, write: if false;
    }

    match /reminders/{id} {
      allow read, write: if false;
    }
  }
}
